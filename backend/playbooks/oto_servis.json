{
  "sektor": "oto_servis",
  "display_name": "Oto Tamir / Servis / Lastikçi",
  "kpi_listesi": [
    "aylik arac sayisi",
    "ortalama is tutari",
    "google maps gorünurlugu"
  ],
  "icp_filtre": {
    "yorum_min": 0,
    "yorum_max": 800,
    "puan_max": 5.0,
    "oncelikli_ilceler": [],
    "site_durumu_kabul": ["yok", "zayif"],
    "eleme_kriterleri": [
      "klinik", "hastane", "eczane", "restoran", "kafe", "güzellik",
      "kuaför", "avukat", "eğitim", "nakliyat", "temizlik", "inşaat"
    ]
  },
  "hook_mantigi": {
    "ana_kayip_birimi": "araç",
    "dusuk_aralik": "10-25 araç/ay",
    "orta_aralik": "25-60 araç/ay",
    "yuksek_aralik": "60-120 araç/ay",
    "varsayilan_guven": 70
  },
  "hook_tipleri": {
    "gap_hook": {
      "aciklama": "Lokal aramada görünmüyor",
      "sablon": "'{ilce} oto tamir' aramasında görünmüyorsunuz — acil arıza anında müşteri sizi bulamıyor, rakibe gidiyor.",
      "tetikleyici": "lead.website mevcut AND audit.genel_skor < 50"
    },
    "data_hook": {
      "aciklama": "Rakip servis verisi",
      "sablon": "{ilce} bölgesinde {rakip_sayi} oto servis Google'da sizi geçiyor — ilk 3 sıra iş alıyor, siz görünmüyorsunuz.",
      "tetikleyici": "audit.reklam_firsati.rakip_durum == aktif"
    },
    "money_hook": {
      "aciklama": "Tahmini aylık kayıp",
      "sablon": "Bu görünürlükle aylık {min}-{max} araç kaçıyor olabilir. (%{guven} güven)",
      "tetikleyici": "her zaman — fallback"
    },
    "tercih_sirasi": ["gap_hook", "data_hook", "money_hook"]
  },
  "audit_kriterleri": [
    {
      "id": "maps_profil",
      "soru": "Google Maps profilinde telefon, fotoğraf ve çalışma saatleri tam mı?",
      "agirlik": 35
    },
    {
      "id": "lokal_seo",
      "soru": "İlçe + oto tamir/servis aramasında ilk sayfada görünüyor mu?",
      "agirlik": 30
    },
    {
      "id": "mobil",
      "soru": "Site mobilde hızlı açılıyor, tıklanabilir telefon ve WhatsApp butonu var mı?",
      "agirlik": 20
    },
    {
      "id": "yorum",
      "soru": "Yorum sayısı 30+ ve puan 4.3+ mi?",
      "agirlik": 15
    }
  ],
  "audit_dil_kurallari": {
    "yasak": ["tespit edildi", "mevcut degil", "onerilir"],
    "zorunlu_format": "Sorun → Kaçan araç → Kısa çözüm",
    "killer_insight_zorunlu": true,
    "kayip_dili": "iş kaybı — arıza anında görünmüyor, rakip alıyor"
  },
  "outreach": {
    "kanal": "WhatsApp veya telefon",
    "ton": "pratik, direkt, somut rakam odaklı",
    "giris_yasak": ["Ajansım var", "hizmet sunuyorum", "size ulaşmak istedim"],
    "giris_onerilen": [
      "Google'daki profilinize baktım",
      "fark ettim ki",
      "dikkatimi çekti"
    ]
  },
  "killer_insight_ornekleri": [
    "'Kadıköy oto tamir' aramasında görünmüyorsunuz — acil arıza anında müşteri rakip servisi seçiyor",
    "Google Maps'te çalışma saati bilgisi yok — müşteri 'açık mı?' diye aramadan geçiyor",
    "Sitede servis hizmetleri listesi yok — müşteri ne yaptığınızı anlamadan sayfayı kapatıyor"
  ],
  "feature_weights": {
    "blog_signal": 0.1,
    "content_depth_signal": 0.3,
    "instagram_signal": 0.4,
    "youtube_signal": 0.2,
    "trust_signal": 1.0,
    "online_booking_signal": 0.5,
    "ads_signal": 1.2,
    "linkedin_signal": 0.0
  }
}
