    {"id": "randevu","soru": "Online randevu sistemi mobilde calisiyor mu?", "agirlik": 25},
    {"id": "guven", "soru": "Uzman hakkinda bilgi ve hasta yorumlari gorunur mu?", "agirlik": 15},
