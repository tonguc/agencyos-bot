      "tetikleyici": "lead.website mevcut AND audit.genel_skor < 50"
    },
    "money_hook": {
      "aciklama": "Tahmini aylik kayip",
      "sablon": "Bu gorunurlukle aylik {min}-{max} konsultasyon kaciyor olabilir. (%{guven} guven)",
      "tetikleyici": "her zaman — fallback"
    },
    "tercih_sirasi": ["data_hook", "gap_hook", "money_hook"]
  },

  "audit_kriterleri": [
    {"id": "oncesi_sonrasi", "soru": "Sitede/Maps'te oncesi-sonrasi fotograflari var mi?", "agirlik": 25},
    {"id": "seo",            "soru": "Hedef operasyon aramasinda ilk sayfada mi?", "agirlik": 25},
    {"id": "guven",          "soru": "Uzmanlik sertifika ve hasta yorumlari gorunur mu?", "agirlik": 20},
    {"id": "form",           "soru": "Online konsultasyon talebi formu var mi?", "agirlik": 20},
    {"id": "hiz",            "soru": "Site mobilde 3 saniyede yükleniyor mu?", "agirlik": 10}
  ],

  "audit_dil_kurallari": {
    "yasak": ["tespit edildi", "mevcut degil", "onerilir"],
    "zorunlu_format": "Sorun → Kayip etkisi → Kisa cozum",
    "killer_insight_zorunlu": true
  },

  "outreach": {
    "kanal": "WhatsApp veya Instagram DM",
    "ton": "prestij odakli, guven veren, somut veri sunar",
    "giris_yasak": ["Ajansim var", "hizmet sunuyorum", "size ulasmak istedim"],
    "giris_onerilen": ["kliniginizdeki bir detay dikkatimi cekti", "web sitenizi inceledim", "farkettigim bir sey var"]
  },

  "killer_insight_ornekleri": [
    "Oncesi-sonrasi fotografi yok — estetik hastasinin karar verdiginin 1 numarali etkeni bu",
    "Google Maps'te 8 fotograf var, rakip klinikte 120 — hasta guveni cok dusuk",
    "Site masaustunde guzel ama mobilde bozuk — hastalarin %80i telefondan ariyor"
  ]
