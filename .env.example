# ─── AgencyOS ────────────────────────────────────────────
APP_ENV=development
AGENCYOS_API_KEY=changeme-generate-a-strong-key

# ─── Database ─────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://agencyos:agencyos@localhost:5432/agencyos

# ─── Redis ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── External APIs ────────────────────────────────────────
CLAUDE_API_KEY=
APIFY_API_TOKEN=
PAGESPEED_API_KEY=

# ─── Logging ──────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=agencyos.log

# ─── Telegram bot (hibrit mod) ────────────────────────────
TELEGRAM_BOT_TOKEN=
ALLOWED_USER_IDS=

# ─── ICP ──────────────────────────────────────────────────
ICP_STRICT_MODE=false
