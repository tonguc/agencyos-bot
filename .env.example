# ─── App ─────────────────────────────────────────────────
APP_ENV=production
AGENCYOS_API_KEY=change-this-to-a-strong-secret

# ─── Database ─────────────────────────────────────────────
POSTGRES_PASSWORD=agencyos
DATABASE_URL=postgresql+asyncpg://agencyos:agencyos@localhost:5432/agencyos

# ─── Redis ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── AI ───────────────────────────────────────────────────
CLAUDE_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-6

# ─── External APIs ────────────────────────────────────────
APIFY_API_TOKEN=apify_api_...
PAGESPEED_API_KEY=AIza...
SERPAPI_API_KEY=

# ─── Logging ──────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=agencyos.log

# ─── ICP ──────────────────────────────────────────────────
ICP_STRICT_MODE=false

# ─── Telegram bot (--profile bot ile aktif) ───────────────
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
ALLOWED_USER_IDS=123456789
AGENCYOS_API_URL=http://localhost:8000

# ─── Frontend (Next.js build'ine islenir) ─────────────────
# Production'da sunucunun public URL'ini yaz
NEXT_PUBLIC_API_URL=http://localhost:8000
